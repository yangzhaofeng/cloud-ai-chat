{
  "name": "cloud-ai-chat",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.functions.json",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "cf:dev": "wrangler pages dev dist",
    "db:init": "wrangler d1 execute cloud-ai-chat --local --file=./schema.sql",
    "db:init:remote": "wrangler d1 execute cloud-ai-chat --remote --file=./schema.sql",
    "deploy": "npm run build && wrangler pages deploy dist"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "@ant-design/x": "^2.9.0",
    "antd": "^6.6.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261005.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^5.9.0",
    "vite": "^8.3.2",
    "wrangler": "^4.147.0"
  }
}
